generator client {
  provider = "prisma-client-js"
}

// Postgres (Neon desde el Marketplace de Vercel). La integración de Neon crea las dos variables:
// DATABASE_URL (con pooler, la usa la app) y DATABASE_URL_UNPOOLED (directa, la usan las migraciones).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("CUSTOMER")
  tokenVersion Int           @default(0)
  createdAt    DateTime      @default(now())
  vehicles     Vehicle[]
  appointments Appointment[]
}

model Vehicle {
  id           String        @id @default(cuid())
  userId       String
  make         String
  model        String
  year         Int
  plate        String
  engine       String?
  tireSize     String?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([userId, plate])
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String
  category     String
  durationMin  Int
  priceCents   Int
  active       Boolean       @default(true)
  imageUrl     String?
  appointments Appointment[]
}

model Appointment {
  id            String   @id @default(cuid())
  userId        String
  vehicleId     String
  serviceId     String
  startsAt      DateTime
  notes         String?
  status        String   @default("PENDING")
  estimateCents Int
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  service       Service  @relation(fields: [serviceId], references: [id])

  @@index([startsAt, status])
  @@index([userId, status])
}

model PartsInventory {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  productBrand  String?
  productModel  String?
  category      String
  priceCents    Int
  stock         Int
  vehicleMake   String?
  vehicleModel  String?
  compatibility String
  tireSize      String?
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

// Límites de intentos compartidos entre instancias de Vercel (la memoria de cada función no se comparte).
// expiresAt va en milisegundos epoch para no depender de la zona horaria de la sesión de Postgres.
model RateLimit {
  key       String @id
  count     Int
  expiresAt BigInt

  @@index([expiresAt])
}
