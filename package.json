{
  "name": "torque-local",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:api\" \"npm:web\"",
    "api": "tsx watch server/index.ts",
    "web": "vite --host 0.0.0.0",
    "db:push": "prisma db push",
    "db:services": "tsx prisma/protires-services.ts",
    "db:migrate-service-images": "tsx prisma/migrate-service-images.ts",
    "build": "prisma generate && vite build && tsc -p tsconfig.server.json",
    "db:create-admin": "tsx prisma/create-admin.ts",
    "start": "node dist-server/server/index.js",
    "db:backup": "tsx prisma/backup.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prisma": "^6.19.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
