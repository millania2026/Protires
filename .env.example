# Postgres. En Vercel las crea la integración de Neon (Storage → Neon); en local usa una rama de Neon o un Postgres propio.
DATABASE_URL="postgresql://usuario:clave@host/protires?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host/protires?sslmode=require"
# Dos secretos aleatorios DISTINTOS de al menos 32 bytes:
#   node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=""
ERP_WEBHOOK_KEY=""
# Fotos de servicios: en Vercel la crea la integración de Blob. Sin ella, en local se guardan en PUBLIC_UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=""
PUBLIC_UPLOAD_DIR="./uploads"
# Opcional: otros orígenes que puedan llamar a la API (el propio dominio siempre está permitido).
CORS_ORIGINS=""
APPOINTMENT_CAPACITY=1
TRUST_PROXY_HOPS=1
PORT=4000
DATABASE_BACKUP_DIR="./backups"
